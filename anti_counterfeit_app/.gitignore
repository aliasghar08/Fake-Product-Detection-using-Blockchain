# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ==========================================
# CRITICAL SECURITY & DEPLOYMENT ADDITIONS
# ==========================================

# 1. Android App Signing Keys (NEVER UPLOAD THESE)
*.jks
*.keystore
android/key.properties

# 2. Environment Variables (For Private Keys / RPC URLs)
.env
.env*

# 3. Firebase Configuration Files
google-services.json
GoogleService-Info.plist
firebase_options.dart

# 4. Desktop Build Artifacts (Keeps repo size small)
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/